programa {
  funcao inicio() {

    inteiro m1[2][4]
    
    para(inteiro linha = 0; linha < 2; linha++)
    {
      para(inteiro coluna = 0; coluna < 4; coluna++)
      {

        escreva("digite o numero de [", linha,"] [", coluna,"] da matriz 1\n")
        leia(m1[linha][coluna])
          
      }
    }
    
  }
}
